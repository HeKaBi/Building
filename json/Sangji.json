{
  "designSystem": {
    "name": "Oriental Classical Sankey Visualization",
    "theme": "Traditional Chinese, Calligraphy, Rice Paper, Earthy Tones",
    "global": {
      "canvas": {
        "backgroundColor": "#F5F4F0",
        "backgroundTexture": "rice-paper-grain",
        "decorativeElements": [
          {
            "type": "scattered-petals",
            "colors": ["#FFD1DC", "#FFC0CB"],
            "opacity": 0.5,
            "density": "sparse",
            "blur": "2px"
          }
        ]
      }
    },
    "typography": {
      "primaryFont": ["STXingkai", "KaiTi", "Brush Script MT", "serif"],
      "title": {
        "fontSize": "28px",
        "fontWeight": "bold",
        "color": "#2C2C2C",
        "letterSpacing": "4px",
        "textAlign": "center"
      },
      "nodeLabels": {
        "fontSize": "14px",
        "fontWeight": "normal",
        "color": "#333333",
        "textShadow": "none",
        "writingMode": "horizontal-tb"
      }
    },
    "colorPalette": {
      "nodeColors": [
        "#60554A", 
        "#4B8C9A", 
        "#788D8E", 
        "#A88463", 
        "#C58370", 
        "#4A5052", 
        "#CDA77C", 
        "#889585"  
      ],
      "linkColor": "#D3D3D3",
      "linkOpacity": 0.35,
      "linkHoverOpacity": 0.6
    },
    "components": {
      "sankeyDiagram": {
        "layout": {
          "direction": "left-to-right",
          "nodeAlign": "justify",
          "columns": 3
        },
        "nodes": {
          "shape": "rectangle",
          "width": "16px",
          "padding": "12px",
          "border": "none",
          "borderRadius": "0px"
        },
        "links": {
          "type": "cubic-bezier-curve",
          "colorMode": "solid-grey", 
          "blendMode": "multiply"
        }
      }
    }
  }
}